dm:sicCode a owl:DatatypeProperty ;
    rdfs:domain dm:SICIndustry ;
    rdfs:range xsd:integer .

dm:sicDivisionOf a owl:ObjectProperty ;
    owl:propertyChainAxiom ( dm:hasSIC dm:inDivision ) .

dm:startDate a owl:DatatypeProperty ;
    rdfs:domain dm:Series ;
    rdfs:range xsd:date .

dm:ticker a owl:DatatypeProperty ;
    rdfs:range xsd:string .

dm:usedIn a owl:ObjectProperty ;
    rdfs:domain dm:Series ;
    rdfs:range dm:LabAssignment .

dm:value a owl:DatatypeProperty ;
    rdfs:domain dm:Result ;
    rdfs:range xsd:decimal .

dm:ComovementCluster a owl:Class ;
    rdfs:subClassOf dm:Cluster .

dm:RiskCluster a owl:Class ;
    rdfs:subClassOf dm:Cluster .

dm:SICDivision a owl:Class ;
    rdfs:label "SIC division" ;
    rdfs:subClassOf dm:Classification .

