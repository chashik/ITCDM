dm:frequency a owl:DatatypeProperty ;
    rdfs:domain dm:Series .

dm:inComovementCluster a owl:ObjectProperty ;
    rdfs:range dm:ComovementCluster ;
    rdfs:subPropertyOf dm:memberOf .

dm:inFFIndustry a owl:ObjectProperty ;
    rdfs:domain dm:Company ;
    rdfs:range dm:FFIndustry .

dm:inLab a owl:ObjectProperty ;
    rdfs:domain dm:Result ;
    rdfs:range dm:LabAssignment .

dm:inRiskCluster a owl:ObjectProperty ;
    rdfs:range dm:RiskCluster ;
    rdfs:subPropertyOf dm:memberOf .

dm:inSector a owl:ObjectProperty ;
    rdfs:domain dm:Company ;
    rdfs:range dm:Sector .

dm:listedOn a owl:ObjectProperty ;
    rdfs:domain dm:Company ;
    rdfs:range dm:Exchange .

dm:metric a owl:DatatypeProperty ;
    rdfs:domain dm:Result .

dm:ofModel a owl:ObjectProperty ;
    rdfs:domain dm:Result ;
    rdfs:range dm:Model .

dm:providedBy a owl:ObjectProperty ;
    rdfs:domain dm:Series ;
    rdfs:range dm:DataProvider .

<http://example.org/gsu-dm#result/lab2_HAR_linear_3_features_test_RMSE_of_log_RV_22_days> a dm:Result ;
